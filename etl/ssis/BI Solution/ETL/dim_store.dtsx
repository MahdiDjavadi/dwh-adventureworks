          SQLTask:SqlStatementSource="INSERT INTO etl.LoadLog (package_name, start_time, status)&#xA;VALUES (?, GETDATE(), 'Running');&#xA;SELECT SCOPE_IDENTITY() AS NewLogID;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
