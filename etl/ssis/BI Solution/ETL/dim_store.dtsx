    <DTS:Executable
      DTS:refId="Package\SQL | DimStore Update ETL Metadata"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{7f6c32e0-c3c5-4e8b-bf2e-306de90a887a}"
