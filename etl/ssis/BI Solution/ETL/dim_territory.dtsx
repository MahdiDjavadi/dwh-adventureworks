                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT   st.TerritoryID                         AS TerritoryID,
                st.[Name]                              AS TerritoryName,
                st.[Group]                              AS TerritoryGroup,
                st.CountryRegionCode       AS CountryRegionCode,
                cr.[Name]                             AS CountryName
FROM     transform.SalesTerritory     AS st
                LEFT OUTER JOIN
                transform.CountryRegion          AS cr
                ON cr.CountryRegionCode = st.CountryRegionCode;</property>
