                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH XMLNAMESPACES ('http://schemas.microsoft.com/sqlserver/2004/07/adventure-works/StoreSurvey' AS ns)
SELECT 
    BusinessEntityID,
    Name AS StoreName,
	SalesPersonID,
    -- استخراج متراژ فروشگاه
    Demographics.value('(/ns:StoreSurvey/ns:SquareFeet)[1]', 'int') AS SquareFeet,
    -- استخراج سال تاسیس
    Demographics.value('(/ns:StoreSurvey/ns:YearOpened)[1]', 'int') AS YearOpened,
    -- استخراج تمرکز محصولات
    Demographics.value('(/ns:StoreSurvey/ns:Specialty)[1]', 'nvarchar(50)') AS Specialty,
    -- استخراج تعداد کارمندان
    Demographics.value('(/ns:StoreSurvey/ns:NumberEmployees)[1]', 'int') AS NumberEmployees,
    -- استخراج تعداد پوشش برندها
    Demographics.value('(/ns:StoreSurvey/ns:Brands)[1]', 'nvarchar(50)') AS Brands
FROM 
    Extract.Store;</property>
