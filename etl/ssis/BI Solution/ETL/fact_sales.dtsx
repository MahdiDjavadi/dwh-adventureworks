        <SQLTask:SqlTaskData
          SQLTask:Connection="{1B3A8471-77E7-4C35-8961-F917CE737C38}"
          SQLTask:SqlStatementSource="UPDATE fact.fact_sales&#xA;SET sys_delete_date = GETDATE()&#xA;WHERE sys_delete_date IS NULL&#xA;  AND sales_order_key NOT IN (&#xA;      SELECT SalesOrderDetailID&#xA;      FROM [STG_AdventureWorks].[transform].[SalesOrderDetail]);&#xA;SELECT @@ROWCOUNT AS RowsDeleted;"
