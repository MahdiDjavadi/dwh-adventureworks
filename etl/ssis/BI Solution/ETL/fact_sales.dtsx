                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    d.SalesOrderDetailID   AS sales_order_key,
    h.SalesOrderID         AS sales_order_id,
    h.DateKey              AS date_key,
    h.OnlineOrderFlag      AS online_order_flag,
    c.AccountNumber        AS CustomerBK,
    c.StoreID              AS StoreBK,
    e.NationalIDNumber     AS SalespersonBK,
    h.TerritoryID          AS TerritoryBK,
    p.ProductNumber        AS ProductBK,
    d.OrderQty             AS order_quantity,
    d.UnitPrice            AS unit_price,
    d.UnitPriceDiscount    AS unit_price_discount,
    d.LineTotal            AS line_total
FROM transform.SalesOrderDetail d
INNER JOIN transform.SalesOrderHeader h ON h.SalesOrderID = d.SalesOrderID
LEFT JOIN  transform.Customer c ON c.CustomerID = h.CustomerID
LEFT JOIN  transform.Employee e ON e.BusinessEntityID = h.SalesPersonID
LEFT JOIN  transform.Product  p ON p.ProductID = d.ProductID;</property>
