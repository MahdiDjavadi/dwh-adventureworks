                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
       c.CustomerID,
       c.AccountNumber,
       c.PersonID,
       c.StoreID,
       c.TerritoryID,
       p.PersonType,
       p.FirstName,
       p.LastName,
       p.EmailPromotion,
       s.[Name] AS Store,
       st.[Name] AS Territory,
       st.CountryRegionCode,
       st.[Group] AS TerritoryGroup
FROM   transform.Customer AS c
       INNER JOIN
       transform.Person AS p
       ON p.BusinessEntityID = c.PersonID
       LEFT OUTER JOIN
       transform.Store AS s
       ON s.BusinessEntityID = c.StoreID
       LEFT OUTER JOIN
       transform.SalesTerritory AS st
       ON st.TerritoryID = c.TerritoryID;</property>
