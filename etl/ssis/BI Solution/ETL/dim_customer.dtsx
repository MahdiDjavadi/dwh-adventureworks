      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1B3A8471-77E7-4C35-8961-F917CE737C38}"
          SQLTask:SqlStatementSource="UPDATE dimension.dim_customer&#xA;SET sys_delete_date = GETDATE()&#xA;WHERE sys_delete_date IS NULL&#xA;  AND [customer_key] &lt;&gt; -1&#xA;  AND is_current = 1&#xA;  AND [account_number_bk] NOT IN (&#xA;      SELECT [AccountNumber]&#xA;      FROM [STG_AdventureWorks].[transform].[Customer]&#xA;  );&#xA;&#xA;SELECT @@ROWCOUNT AS RowsDeleted;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsDeleted"
            SQLTask:DtsVariableName="User::RowsDeleted" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
