                    <arrayElement
                      dataType="System.String"><![CDATA[#region Namespaces
using System;
using System.Data;
using System.Security.Cryptography;
using System.Text;
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;
#endregion

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    public override void Input0_ProcessInputRow(Input0Buffer Row)
    {
        var sb = new StringBuilder();

        // ==== EDIT PER PROJECT: list only business attributes, exclude keys/dates ====
        sb.Append(Row.AccountNumber).Append('|');
        sb.Append(Row.PersonType).Append('|');
        sb.Append(Row.FirstName).Append('|');
        sb.Append(Row.LastName).Append('|');
        sb.Append(Row.EmailPromotion).Append('|');
        sb.Append(Row.StoreClean).Append('|');
        sb.Append(Row.CountryRegionCode).Append('|');
        sb.Append(Row.TerritoryGroup).Append('|');
        sb.Append(Row.Territory);
        // ==== END EDIT ====

        using (var sha256 = SHA256.Create())
        {
            byte[] hashBytes = sha256.ComputeHash(Encoding.UTF8.GetBytes(sb.ToString()));
            Row.RowHash = BitConverter.ToString(hashBytes).Replace("-", "");
        }
    }
}]]></arrayElement>
