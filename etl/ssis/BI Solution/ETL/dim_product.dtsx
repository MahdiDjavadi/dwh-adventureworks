      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1B3A8471-77E7-4C35-8961-F917CE737C38}"
          SQLTask:SqlStatementSource="UPDATE dimension.dim_product&#xA;SET sys_delete_date = GETDATE()&#xA;WHERE sys_delete_date IS NULL&#xA;  AND [product_code_bk] NOT IN (&#xA;      SELECT [ProductNumber]&#xA;      FROM [STG_AdventureWorks].[transform].[Product]&#xA;  );&#xA;&#xA;SELECT @@ROWCOUNT AS RowsDeleted;"
