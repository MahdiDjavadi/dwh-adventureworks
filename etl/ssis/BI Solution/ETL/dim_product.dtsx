                <component
                  refId="Package\Load Layer (GOLD)\DFT | Load DimProduct\SRC | Read Query Product"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="SRC | Read Query Product"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
       p.ProductID
      ,p.Name as ProductName
      ,p.ProductNumber
      
      ,p.Size
      ,um1.Name as SizeMeasureUnit
      
      ,p.Weight
      ,um2.Name as WeightMeasureUnit
      
      ,p.ProductLine
      ,p.Class
      ,p.Style
      ,p.Color
      
      ,p.ProductSubcategoryID
      ,ps.Name as ProductSubcategory
      
      ,ps.ProductCategoryID
      ,pc.Name as ProductCategory
      
      ,p.ProductModelID
      ,pm.Name as ProductModel
      
      ,p.SellStartDate
      ,p.SellEndDate
      ,p.DiscontinuedDate

  FROM transform.[Product]    As  P
  LEFT JOIN transform.ProductSubcategory as ps on ps.ProductSubcategoryID = p.ProductSubcategoryID
  left join transform.ProductCategory as pc on pc.ProductCategoryID = ps.ProductCategoryID
  left join transform.ProductModel as pm on pm.ProductModelID = p.ProductModelID
  left join transform.UnitMeasure as um1 on um1.UnitMeasureCode = p.SizeUnitMeasureCode
  left join transform.UnitMeasure as um2 on um2.UnitMeasureCode = p.WeightUnitMeasureCode;</property>
